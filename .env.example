# ============================================================
# ERP AI 智能管理系统 — 环境变量模板
# ============================================================
# 使用方式：复制此文件为 .env.dev / .env.staging / .env.prod 并填入实际值
# WARNING: .env.dev / .env.staging / .env.prod 包含敏感信息，严禁提交到 Git
# 仓库中仅保留此 .env.example 模板文件
# ============================================================

# ==================== 通用配置 ====================
COMPOSE_PROJECT_NAME=erp
ENV=dev                          # dev / staging / prod
TZ=Asia/Shanghai
TAG=latest                       # 镜像标签

# ==================== Nginx 端口 ====================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ==================== PostgreSQL ====================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=erp
DB_USER=erp_user
DB_PASSWORD=<replace-me>         # 必填：使用 openssl rand -base64 32 生成
DB_POOL_SIZE=20

# ==================== Redis ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<replace-me>      # 必填：使用 openssl rand -base64 32 生成

# ==================== MinIO 对象存储 ====================
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=erp_minio
MINIO_SECRET_KEY=<replace-me>    # 必填：使用 openssl rand -base64 32 生成
MINIO_BUCKET=erp-files

# ==================== Elasticsearch ====================
ES_HOST=elasticsearch
ES_PORT=9200
# 生产环境启用 xpack security 后填写
# ES_USERNAME=elastic
# ES_PASSWORD=<replace-me>       # 必填：使用 openssl rand -base64 32 生成

# ==================== 后端应用 (Spring Boot) ====================
SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC
JWT_SECRET=<replace-me>          # 必填：使用 openssl rand -hex 32 生成 256 位密钥
JWT_EXPIRATION=86400

# ==================== 日志级别 ====================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_ERP=INFO

# ==================== 前端应用 ====================
VITE_API_BASE_URL=/api
VITE_APP_TITLE=ERP管理系统

# ==================== 外部服务（可选）====================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=<replace-me>
# SMS_API_KEY=<replace-me>
