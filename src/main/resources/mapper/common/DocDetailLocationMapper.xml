<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.common.mapper.DocDetailLocationMapper">

    <!-- ==================== 基础字段列表 ==================== -->
    <sql id="Base_Column_List">
        id, tenant_id, created_at, updated_at, created_by, updated_by,
        is_deleted, owner_dept_id, owner_id, version,
        detail_id, location_code, warehouse_code, area_code, shelf_code, layer_code, quantity, is_default
    </sql>

    <!-- ==================== DocDetailLocation 基础映射 ==================== -->
    <resultMap id="BaseResultMap" type="com.erp.common.entity.DocDetailLocation">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="created_at" property="createTime"/>
        <result column="updated_at" property="updateTime"/>
        <result column="created_by" property="creatorId"/>
        <result column="updated_by" property="updaterId"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="owner_dept_id" property="ownerDeptId"/>
        <result column="owner_id" property="ownerId"/>
        <result column="version" property="version"/>
        <result column="detail_id" property="detailId"/>
        <result column="location_code" property="locationCode"/>
        <result column="warehouse_code" property="warehouseCode"/>
        <result column="area_code" property="areaCode"/>
        <result column="shelf_code" property="shelfCode"/>
        <result column="layer_code" property="layerCode"/>
        <result column="quantity" property="quantity"/>
        <result column="is_default" property="isDefault"/>
    </resultMap>

    <!-- ==================== 按明细ID查询库位列表 ==================== -->
    <select id="selectByDetailId" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM doc_detail_location
        WHERE detail_id = #{detailId}
          AND is_deleted = FALSE
    </select>

</mapper>
